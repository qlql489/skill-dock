{
  "name": "skill-dock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,tauri -c blue,magenta \"npm:dev:frontend\" \"npm:dev:tauri\"",
    "dev:frontend": "vite",
    "dev:tauri": "node ./scripts/sync-version.mjs && tauri dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync:version": "node ./scripts/sync-version.mjs",
    "tauri": "node ./scripts/sync-version.mjs && tauri",
    "tauri:build": "node ./scripts/sync-version.mjs && tauri build --config src-tauri/tauri.private-ci.conf.json",
    "tauri:build:signed": "node ./scripts/sync-version.mjs && tauri build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.2",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "lucide": "^1.31.0",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
